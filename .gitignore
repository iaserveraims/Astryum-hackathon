# Claude Code skills cache (regenerable via skills-lock.json + `npx skills add`)
# Same pattern as node_modules: the lock is committed, the install dir isn't
.agents/skills/
.claude/skills/

# Personal, per-machine permission overrides — never in the due-diligence repo
.claude/settings.local.json

# Archived code (excluded from builds)
# Archived 2026-02-02: Pre-Flare migration code
_archived/

# But keep reusable patterns accessible for reference
!_archived/reusable-patterns/

# Windows reserved names (prevent git add errors)
nul
NUL
con
CON
prn
PRN
aux
AUX
com[1-9]
COM[1-9]
lpt[1-9]
LPT[1-9]
# Design-system sync tooling + generated bundle — regenerated by the DesignSync tool.
# .ds-sync bundles its own node_modules (~54MB); ds-bundle is build output. Never commit
# these to the due-diligence repo. .design-sync/ INPUTS are committed; its caches are not.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Foundry build artifacts (contracts/ — regenerable via forge build)
contracts/out/
contracts/cache/
contracts/broadcast/

# Originales de los retratos de /about (8 MB, con EXIF completo: GPS del
# dispositivo, marca/modelo y fecha). Las versiones servidas viven ya
# despojadas en frontend/public/founders/ — los originales NUNCA entran en git.
assets/
