# ============================================================
# VARIABLES DE ENTORNO — copiar a .env.local para desarrollo
# En Vercel: añadir en Project Settings → Environment Variables
# ============================================================

# --- URLs principales ---
NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app
# En desarrollo: http://localhost:3000

# URL del backend (Railway/Render en producción, localhost en dev)
NEXT_PUBLIC_API_URL=https://tu-backend.railway.app/api
# En desarrollo: http://localhost:3001/api

# URL WebSocket del backend (wss en producción)
NEXT_PUBLIC_WS_URL=wss://tu-backend.railway.app
# En desarrollo: ws://localhost:3001

# --- Modo mock (sin backend) ---
# true = usa datos de prueba, no necesita backend activo
# false = requiere backend activo (DEFAULT V1)
NEXT_PUBLIC_USE_MOCK_DATA=false

# Canvas execution backend mode:
# 'backend' = call /api/tx/prepare or V1 intents
# 'simulation' = simulate locally without backend (dev)

# Use V1 Intent flow in canvas (Fase E+F):
# true = useFlowExecutionV1 (intents + simulation persistence + AuditLog)
# false = legacy useFlowExecution (eth_sendTransaction directo)
NEXT_PUBLIC_USE_V1_INTENTS=true

# SIWE auth gating (set to 'false' to bypass /login redirect during dev):
NEXT_PUBLIC_REQUIRE_SIWE=true

# --- Gate de acceso pre-lanzamiento (2026-07-23) ---
# El dashboard (/app, /login, /register, /forgot-password) queda CERRADO tras
# un código de acceso verificado en servidor (middleware + cookie httpOnly
# firmada). Las TRES variables son server-only (sin NEXT_PUBLIC_): nunca
# llegan al bundle. En dev sin configurar → gate abierto. En producción sin
# configurar → gate CERRADO (fail-closed).
# ACCESS_GATE_CODE: el código que tecleáis tú y los jueces (elige uno nuevo,
#   el viejo "astryum2026" está quemado — iba dentro del bundle público).
# ACCESS_GATE_SECRET: firma HMAC de la cookie. Generar: openssl rand -hex 32
# ACCESS_GATE_OPEN: interruptor de lanzamiento — apaga el gate sin deploy.
#   Acepta 1 / true / yes / on. OJO: hasta el 2026-08-07 solo valía el literal
#   "1", y los runbooks de la beta decían "true" — el interruptor se ponía y el
#   gate seguía cerrado, con los CTAs dorados de la landing rebotando en /login.
ACCESS_GATE_CODE=
ACCESS_GATE_SECRET=
ACCESS_GATE_OPEN=

# --- Anti-bot (Cloudflare Turnstile) ---
# Sitekey pública que renderiza el widget en login/registro/waitlist/admin.
# El SECRET va en el backend (TURNSTILE_SECRET_KEY) y también aquí como
# server-only para /api/access-gate. Sin sitekey → widget oculto y checks off.
# Par de test que siempre pasa: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Puertas de entrada ---
# Decisión del fundador (17-ago-2026): en PRODUCCIÓN se entra SOLO por XRP
# Identity. Email, Google, Apple y passkey siguen construidos y testeados, pero
# se ocultan donde la puerta única funciona y aparecen donde NO puede funcionar
# (preview de Vercel, localhost: su redirect URI no está registrada en
# account.xrpl.in). Eso lo decide el código solo — ver src/lib/authDoors.ts —
# y esta variable es únicamente el mando manual para el día que su SSO se caiga:
#   true  → fuerza las puertas viejas visibles en cualquier origen
#   false → las cierra en todos, incluido preview
# Vacío = automático (lo normal). OJO: NEXT_PUBLIC_* se hornea en el build, así
# que cambiarla en Vercel exige REDEPLOY, no basta con guardar la variable.
#
# PREVIEW CON PUERTA ÚNICA (19-ago): NO hace falta esta variable. En cuanto la
# URI de retorno del preview esté en XRPL_IDENTITY_REDIRECT_URIS (Railway) y
# registrada por el operador, la regla automática ve que la puerta SÍ puede
# completar ahí y esconde las viejas ella sola — que es el orden correcto.
# Ponerla a 'false' ANTES de esas dos altas fuerza el aspecto pero deja el
# preview sin ninguna entrada utilizable: se ve el botón y el clic responde
# `xrplid_redirect_not_registered`. Nunca deja la tarjeta vacía (authDoors
# garantiza que siempre se pinta al menos una puerta), pero tampoco deja entrar.
NEXT_PUBLIC_LEGACY_AUTH_DOORS=

# --- OAuth (Google / Apple) ---
# Client ids públicos por diseño (no son secretos). Sin configurar → el botón
# queda como placeholder honesto. Guía completa: docs/AUTH_SETUP.md
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
# Debe coincidir EXACTAMENTE con un Return URL del Services ID de Apple.
# Por defecto: <origin>/login
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# --- Funcionalidades ---
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_AI=false
NEXT_PUBLIC_DEBUG=false

# --- Wallets ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=obtener_en_cloud.walletconnect.com

# Xaman (XUMM) para XRPL
# API KEY pública: identificador del flujo de login PKCE en el cliente (lib/xaman). OK como NEXT_PUBLIC_.
NEXT_PUBLIC_XAMAN_API_KEY=your_xaman_api_key_here
# Credenciales SERVER-ONLY para las rutas /api/xaman/* (Xumm platform API).
# NUNCA uses NEXT_PUBLIC_ para el SECRET: no debe llegar al bundle del cliente.
XAMAN_API_KEY=your_xaman_api_key_here
XAMAN_API_SECRET=your_xaman_api_secret_here
# Webhook URL: pública (es una URL, no un secreto).

# --- API Keys opcionales ---

# --- RPCs Blockchain ---
#
# EL RPC QUE LEE LOS RECIBOS EN EL NAVEGADOR. ETHEREUM_RPC_URL (Railway) NO
# cubre esto: aquella es del backend. Esta lectura la hace el navegador, entre
# pata y pata de una firma multi-paso, y es donde un 429 corta la secuencia y
# obliga a decir «EN VUELO».
#
# Sin poner, se cae al nodo publico (funciona para leer, pero cuota compartida).
# Para el ensayo E2E pon una clave PROPIA. Y que sea una clave APARTE de la del
# backend, de solo lectura y restringida por dominio: esta URL la ve cualquiera
# porque la usa el navegador. Asi no es un secreto — es una cuota con tu nombre.
# NEXT_PUBLIC_* se inyecta en BUILD: cambiarla exige redeploy de Vercel.
# NEXT_PUBLIC_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/TU_CLAVE_DE_FRONTEND
# NEXT_PUBLIC_FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc

# --- W3: FXRP/RLUSD lend-borrow en Ethereum (plan §13 / BuildSpec B4) ---
# Gemelo frontend de ETH_RLUSD_FXRP_ENABLED (backend/Railway). Al activarlo,
# chain 1 entra en DEMO_CHAIN_IDS y la posicion del mercado se ve en Portfolio.
# NEXT_PUBLIC_* se inyecta en build: cambiarla exige redeploy de Vercel.
NEXT_PUBLIC_ETH_RLUSD_FXRP_ENABLED=false

# ---- Institutional potes (demo 21-sep) — ships OFF ----
NEXT_PUBLIC_INSTITUTIONAL_ENABLED=false
NEXT_PUBLIC_POTE_A_ADDRESS=
NEXT_PUBLIC_POTE_B_ADDRESS=
