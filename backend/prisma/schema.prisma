// ============================================================================
// MoneyFlows / canvas (migrated from MongoDB Mongoose, May 2026)
// ============================================================================
// Backstory: pre-V1 these lived in Mongoose (MoneyFlow, FlowRun, Strategy,
// Workspace). V1 engines were on Prisma/Postgres. To consolidate on a single
// DB we moved canvas data to Postgres with JSON columns for the heterogeneous
// node/edge/metadata blobs. Names prefixed `MoneyFlow*` to avoid collision
// with the (currently zombie) `Strategy` and `Instance` models above.

model MoneyFlow {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  description    String?
  tags           String[] @default([])
  nodes          Json     @default("[]")
  edges          Json     @default("[]")
  version        Int      @default(1)
  isPublic       Boolean  @default(false)
  enabled        Boolean  @default(false)
  triggers       Json?
  userAddresses  Json?
  walletBindings Json?
  metadata       Json?
  clonedFromId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  runs MoneyFlowRun[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, name])
  @@map("money_flows")
}

model MoneyFlowRun {
  id         String    @id @default(cuid())
  flowId     String
  versionId  String?
  mode       String    @default("dev") // dev | guarded | real
  status     String    @default("queued") // queued | running | success | error | cancelled | completed
  params     Json?
  progress   Int       @default(0)
  metrics    Json?
  events     Json      @default("[]")
