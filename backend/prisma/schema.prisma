// ============================================================================
// CORE DOMAIN — Defibro engines (Chain, Protocol, Position, Intent, Automation)
// ============================================================================

// Non-EVM chains use synthetic negative chainIds: XRPL=-1, Solana=-2, Bitcoin=-3.
// CAIP-2 is the canonical identifier; chainId is kept for EVM compatibility.
model Chain {
  id           String   @id @default(cuid())
  chainId      Int      @unique  // EVM chain ID or synthetic negative for non-EVM
  name         String
  chainType    String   @default("evm")  // "evm" | "xrpl" | "solana" | "bitcoin" | "cosmos"
  isEvm        Boolean  @default(true)
  caip2        String?  @unique  // "eip155:14", "xrpl:0", "solana:mainnet"
  rpcHttp      String
  rpcWs        String?
  explorer     String
  blockTime    Int      // milliseconds (approximate for non-EVM)
  nativeSymbol String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  wallets            Wallet[]
  protocols          Protocol[]
  positions          Position[]
  portfolioSnapshots PortfolioSnapshot[]
  intents            TransactionIntent[]

  @@map("chains")
}

model Protocol {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  category  ProtocolCategory
  chainId   Int
  riskTier  Int              @default(3) // 1 = safest, 5 = riskiest
  isActive  Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  chain           Chain               @relation(fields: [chainId], references: [chainId], onDelete: Cascade)
  positions       Position[]
  intents         TransactionIntent[]
  automationRules AutomationRule[]

  @@index([chainId, category, isActive])
  @@map("protocols")
}

enum ProtocolCategory {
  LENDING
  DEX
  STAKING
  BRIDGE
}

model Position {
  id            String       @id @default(cuid())
  walletId      String
  protocolId    String
  chainId       Int
  kind          PositionKind
  asset         String // canonical token address
  amount        Decimal      @db.Decimal(38, 18)
  amountUSD     Decimal      @db.Decimal(38, 18)
  metadata      Json
  lastSeenBlock BigInt?
  discoveredAt  DateTime     @default(now())
  closedAt      DateTime?
  updatedAt     DateTime     @updatedAt

  // Relations
  wallet    Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  protocol  Protocol            @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  chain     Chain               @relation(fields: [chainId], references: [chainId], onDelete: Cascade)
  snapshots PositionSnapshot[]
  intents   TransactionIntent[]

  @@index([walletId, kind])
  @@index([protocolId, kind])
  @@index([chainId, walletId])
  @@map("positions")
}

enum PositionKind {
  SUPPLY
  BORROW
  LP
  STAKE
  REWARD
  FREE
}

model PositionSnapshot {
  id          String   @id @default(cuid())
  positionId  String
  takenAt     DateTime @default(now())
  amount      Decimal  @db.Decimal(38, 18)
  amountUSD   Decimal  @db.Decimal(38, 18)
  priceUSD    Decimal  @db.Decimal(38, 18)
  hf          Float?
  ltv         Float?
  metricsJson Json

  // Relations
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId, takenAt])
  @@map("position_snapshots")
}

model TransactionIntent {
  id                 String       @id @default(cuid())
  owner              String
  walletId           String
  chainId            Int
  sessionId          String
  action             IntentAction
  protocolId         String
  positionId         String?
  simulationResultId String?
  inputs             Json
  preState           Json
  simulation         Json
  simulatedAt        DateTime
  pricesFreshAt      DateTime
  impact             Json
  riskDelta          Json
  explanation        String
  warnings           String[]     @default([])
  txData             Json?
  status             IntentStatus @default(building)
  txHash             String?      @unique
  confirmedAt        DateTime?
  failureReason      String?
  blockNumber        BigInt?
  createdAt          DateTime     @default(now())
  expiresAt          DateTime
  updatedAt          DateTime     @updatedAt

  // Relations
  wallet            Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  chain             Chain              @relation(fields: [chainId], references: [chainId], onDelete: Cascade)
  protocol          Protocol           @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  position          Position?          @relation(fields: [positionId], references: [id], onDelete: SetNull)
  simulationResult  SimulationResult?  @relation(fields: [simulationResultId], references: [id], onDelete: SetNull)
  automationRuns    AutomationRun[]
  aiRecommendations AiRecommendation[]
  transactionRecord TransactionRecord?
  partnerIntents    PartnerIntent[]
  bundleSteps       BundleStep[]

  @@index([owner, status])
  @@index([status, expiresAt])
  @@index([walletId, createdAt])
  @@map("transaction_intents")
}

model SimulationResult {
  id             String   @id @default(cuid())
  walletAddress  String
  actionType     String
  protocolId     String
  positionId     String?
  input          Json
  before         Json
  after          Json
  delta          Json
  warnings       String[] @default([])
  assumptions    String[] @default([])
  gasEstimate    String // bigint serialized
  gasEstimateUSD Float
  confidence     Float    @default(0.5)
  pricesFreshAt  DateTime
  isStale        Boolean  @default(false)
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  intents TransactionIntent[]

  @@index([walletAddress, createdAt])
  @@index([positionId])
  @@map("simulation_results")
}

model TransactionRecord {
  id                String         @id @default(cuid())
  intentId          String         @unique
  walletAddress     String
  chainId           Int
  txHash            String         @unique
  status            TxRecordStatus @default(PENDING)
  blockNumber       BigInt?
  gasUsed           BigInt?
  effectiveGasPrice BigInt?
  error             String?
  receiptJson       Json?
  createdAt         DateTime       @default(now())
  confirmedAt       DateTime?

  intent TransactionIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([walletAddress, createdAt])
  @@map("transaction_records")
}

enum TxRecordStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum IntentAction {
  repay
  addCollateral
  withdraw
  supply
  borrow
  harvest
  exitLP
  addLiquidity
  swap
  stake
  unstake
  crossChainSwap
  wrap
  unwrap
  delegate
  undelegate
  claimRewards
}

enum IntentStatus {
  pending_user_review
  building
  proposed
  expired
  signed
  broadcast
  mempool
  confirmed
  failed
}

enum IntentAuthorizationSessionStatus {
  pending_user_review
  user_authorized
  cancelled
  expired
  // NOTE: no submitted/confirmed/failed/relayed — DeFiBro does not track broadcast lifecycle
}

model AutomationRule {
  id                  String    @id @default(cuid())
  walletId            String
  protocolId          String?
  name                String
  trigger             Json // TriggerConfig discriminated union (validated by Zod)
  action              Json // AutomationAction
  /// CanonicalMoneyFlow id — N rules compiled from one CMF share it (one rule
  /// per CanonicalStep; canonical/moneyflow/CanonicalEvmTranslator). Null for
  /// rules created directly (PROTECT/HARVEST templates, manual).
  canonicalRef        String?
  enabled             Boolean   @default(true)
  cooldownMinutes     Int       @default(15)
  maxValueUSD         Float
  totalTimesTriggered Int       @default(0)
  lastTriggeredAt     DateTime?
  /// Enforced TTL (guardarraíl MoneyFlows: sin caducidad + revocación no se
  /// entrega). Required (≤90d, server-clamped) for moneyflow-origin rules
  /// (canonicalRef) and council rules; nullable for legacy manual/template
  /// rows. The tick disables an expired rule instead of evaluating it.
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  wallet            Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  protocol          Protocol?          @relation(fields: [protocolId], references: [id], onDelete: SetNull)
  runs              AutomationRun[]
  aiRecommendations AiRecommendation[]

  @@index([walletId, enabled])
  @@index([canonicalRef])
  @@map("automation_rules")
}

model AutomationRun {
  id          String              @id @default(cuid())
  ruleId      String
  intentId    String?
  triggeredAt DateTime            @default(now())
  triggerData Json
  status      AutomationRunStatus @default(triggered)
  notes       String?

  // Relations
  rule   AutomationRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  intent TransactionIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull)
  alerts Alert[]

  @@index([ruleId, triggeredAt])
  @@map("automation_runs")
}

enum AutomationRunStatus {
  triggered
  intent_prepared
  /// Governed MoneyFlow: the trigger composed a council proposal (the quorum signs it).
  proposal_created
  user_acted
  expired
  error
}

model AiRecommendation {
  id             String    @id @default(cuid())
  walletId       String
  kind           String // 'risk_alert' | 'rebalance' | 'harvest' | ...
  summary        String
  body           String
  linkedIntentId String?
  linkedRuleId   String?
  confidence     Float     @default(0.0)
  createdAt      DateTime  @default(now())
  dismissedAt    DateTime?

  // Relations
  wallet       Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  linkedIntent TransactionIntent? @relation(fields: [linkedIntentId], references: [id], onDelete: SetNull)
  linkedRule   AutomationRule?    @relation(fields: [linkedRuleId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@map("ai_recommendations")
}

