// P17 — Wallet Binding: proven wallet ownership via signature
// mode 'read' = monitor only · 'read_and_receive' = eligible for DeFi/transfer actions
model WalletBinding {
  id             String    @id @default(cuid())
  userId         String
  address        String
  chainType      String    // 'evm' | 'solana' | 'xrpl' | 'bitcoin'
  label          String?
  mode           String    @default("read")  // 'read' | 'read_and_receive'
  signatureProof String    // raw signature stored for audit
  isActive       Boolean   @default(true)
  linkedAt       DateTime  @default(now())
  lastSeenAt     DateTime?
  kycLinked      Boolean   @default(false) // true once synced to Persona inquiry
  kycLinkedAt    DateTime?                 // when the Persona tag was confirmed

