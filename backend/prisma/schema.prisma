// backend/prisma/schema.prisma
generator client {
  provider      = "prisma-client-js"
  // Production runs on node:20-alpine which ships OpenSSL 3.x. Without an
  // explicit linux-musl-openssl-3.0.x target, Prisma falls back to a binary
  // that links libssl.so.1.1 and crashes at runtime with
  // "Error loading shared library libssl.so.1.1".
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL must point at Supabase's Transaction Pooler (port 6543) so
  // Railway can actually reach it over IPv4. Prepared statements are disabled
  // by adding ?pgbouncer=true&connection_limit=1 in the env value.
  url       = env("DATABASE_URL")
  // DIRECT_URL is used by `prisma migrate deploy` and `prisma db push` —
  // these need real Postgres prepared statements and must NOT go through the
  // transaction pooler. Point it at the Session Pooler (port 5432).
  directUrl = env("DIRECT_URL")
}

// User Management
// Identity is internal (cuid). All chain addresses live in the Wallet table.
// xrplAddress kept for Xaman login flow (optional — EVM-only users have none).
model User {
  id                   String    @id @default(cuid())
  xrplAddress          String?   @unique
  email                String?   @unique
  // Demo-signup profile (founder 2026-07-18): light on purpose — phone/2FA
  // arrive with the full product, not the demo.
  username             String?
  firstName            String?
  lastName             String?
  // Presentation avatar: a small downscaled data-URL (client caps ~96px) or
  // null. Never a remote URL fetched server-side.
  avatar               String?
  passwordHash         String?   // scrypt hash — null for SIWE-only users
  resetToken           String?   @unique // SHA-256 hash of password reset token
  resetTokenExpiresAt  DateTime?
  // Auth provenance (2026-07-23): how the account was created — 'email'
  // (password), 'google' / 'apple' (OAuth), 'wallet' (SIWE/Xaman). The admin
  // panel separates OAuth users from plain-email users on this.
  authProvider         String    @default("email")
  // "<provider>:<sub>" — the stable OAuth subject. Written once on first
  // OAuth login (create or link), never overwritten.
  oauthSub             String?   @unique
  // True when the address was attested by an OAuth provider (Google/Apple
  // always verify). Plain email registration stays false until the full
  // product ships its own verification loop.
  emailVerified        Boolean   @default(false)
  preferences          Json?
  isActive             Boolean   @default(true)
  lastLogin            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // KYC / Identity — Persona KYC provider (V1.2)
  // DeFiBro never stores documents — only the approval signal from the provider.
  kycVerified          Boolean   @default(false)
  kycTier              String    @default("none") // 'none' | 'basic' | 'advanced'
  kycLevel             String?   // 'tier1' | 'tier2' as reported by Persona
  kycVerifiedAt        DateTime?
  kycProvider          String?   // 'persona'
  personaInquiryId     String?   // Persona inquiry ID — bridges identity ↔ wallets

  // Relations
  wallets          Wallet[]
  strategies       Strategy[]
  instances        Instance[]
  alerts           Alert[]
  aiConversations  AIConversation[]
  transactions     TransactionExecution[]
  sharedStrategies SharedStrategy[]
  partnerIntents   PartnerIntent[]
  taxEvents        TaxEvent[]
  watchlist           WalletWatchlist[]
  walletBindings      WalletBinding[]
  governedAccounts    GovernedAccount[]
  triggerRules        TriggerRule[]
  agentConversations  AgentConversation[]
  agentDocuments      AgentDocument[]
  agentRules          AgentRule[]
  mcpConnections      UserMCPConnection[]
  anthropicKey        UserAnthropicKey?
  goalRequests        GoalRequest[]
  managerFilter       ManagerFilter?
  managerProfile      ManagerProfile?
  delegationMandates  DelegationMandate[]   @relation("UserMandates")
  managedMandates     DelegationMandate[]   @relation("ManagerMandates")
  intentBundles       IntentBundle[]
  stepUpLockConfig    StepUpLockConfig?
  passkeyCredentials  PasskeyCredential[]

  @@map("users")
}

// ─── Step-Up Signature Lock (configurable, opt-in) ───────────────────────────
// One row per user. The `matrix` JSON maps a protected feature to whether a
// fresh wallet signature is required for READ and/or WRITE, e.g.
//   { "moneyflows": { "read": false, "write": true }, "goals": {...}, ... }
// When `enabled` is false the whole feature is inert (no prompts anywhere).
model StepUpLockConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  enabled         Boolean  @default(false)
  grantTtlSeconds Int      @default(300) // how long a step-up grant stays valid
  matrix          Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("step_up_lock_configs")
}

// ─── Passkey / WebAuthn credentials (@simplewebauthn) ────────────────────────
// A user may register multiple passkeys (one per device). publicKey holds the
// COSE-encoded key; counter guards against cloned-authenticator replay.
model PasskeyCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique // base64url-encoded credential ID
  publicKey    Bytes              // COSE public key
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceLabel  String?
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

// Wallet Management
model Wallet {
  id           String   @id @default(cuid())
  userId       String
  // walletType: metamask | walletconnect | xaman | crossmark | gemwallet | ledger | trezor | phantom | keplr | manual
  walletType   String
  address      String
  network      String   // legacy human label ("ethereum", "xrpl", ...) — use caip2 for new code
  chainId      Int?     // FK -> Chain.chainId; null for chains not yet in registry
  caip2        String?  // CAIP-2 canonical ID: "eip155:14", "eip155:1", "xrpl:0", "solana:mainnet"
  wcTopic      String?  // WalletConnect v2 session topic — groups all accounts from one session
  nickname     String?
  isConnected  Boolean  @default(true)
  permissions  Json     // WalletPermissions object
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ─── Block G (2026-06-02) — unified Wallet model ─────────────────────────
  /// Ecosystem the wallet belongs to, derived from caip2 prefix at write time:
  ///   eip155:* → 'evm' | solana:* → 'solana' | xrpl:* → 'xrpl' |
  ///   aptos:*  → 'aptos' | cosmos:* → 'cosmos'
  /// Stored explicitly so it can be indexed and queried by router.
  ecosystem    String   @default("evm")

  /// Exactly ONE wallet per (userId, ecosystem) may have isPrimary=true.
  /// Enforced by a partial unique index (see migration SQL).
  /// The primary wallet is the default recipient for cross-ecosystem bridges
  /// and the default signer for new operations in that ecosystem.
  isPrimary    Boolean  @default(false)

  /// Role of this wallet in DeFiBro:
  ///   'sign'             → user signs operations with it (active execution)
  ///   'watch'            → Capital Map only (replaces legacy WalletWatchlist)
  ///   'both'             → sign + watch (typical for connected wallets)
  ///   'destination_only' → just a delivery address (manual paste, no signing)
  purpose      String   @default("sign")

  // Relations
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain                    Chain?                    @relation(fields: [chainId], references: [chainId], onDelete: SetNull)
  transactionConfirmations TransactionConfirmation[]
  transactionExecutions    TransactionExecution[]
  positions                Position[]
  portfolioSnapshots       PortfolioSnapshot[]
  intents                  TransactionIntent[]
  alertsFor                Alert[]
  automationRules          AutomationRule[]
  aiRecommendations        AiRecommendation[]
  taxEvents                TaxEvent[]
  bundleStepsAsSigner      BundleStep[]              @relation("BundleStepSigner")

  @@unique([userId, address, network])
  @@index([userId, chainId])
  @@index([userId, ecosystem, isPrimary])
  @@index([userId, purpose])
  @@map("wallets")
}

// ─── Block G (2026-06-02) — Cross-ecosystem bundles ──────────────────────────
//
// An IntentBundle sequences multiple signatures across ecosystems when the
// user's source ecosystem differs from the destination protocol's. Bundle
// invariants (REGULATORY — never relax):
//   - DeFiBro never broadcasts. Each step is signed by the user's wallet
//     partner; the wallet partner transmits.
//   - Step N+1 NEVER advances until Step N reports status='confirmed' AND
//     the partner status endpoint validates the transfer succeeded.
//   - On Step 0 bridge failure → bundle.status='failed' → Step 1 is NEVER
//     issued. The watcher refuses to advance.
//   - 24h TTL from createdAt. Expired bundles cannot resume; the user starts
//     fresh.

model IntentBundle {
  id                 String   @id @default(cuid())
  userId             String
  /// 'simple' (single-step) | 'cross_ecosystem' (2+ steps with bridge)
  kind               String

  /// Bundle status FSM:
  ///   'pending'           initial, no step has been signed yet
  ///   'step1_signed'      Step 0 broadcast, awaiting bridge confirmation
  ///   'bridge_confirmed'  Step 0 confirmed by partner; Step 1 ready to sign
  ///   'step2_signed'      Step 1 broadcast (terminal for simple bundles too)
  ///   'completed'         all steps confirmed
  ///   'failed'            any step failed; downstream steps are blocked
  ///   'expired'           passed 24h TTL before completion
  ///   'cancelled'         user cancelled
  status             String   @default("pending")

  /// Snapshot of the resolver decision for audit:
  ///   { srcEcosystem, dstEcosystem, srcWalletId, dstWalletId,
  ///     finalAction, finalProtocolSlug, finalChainId, assetSymbol, amount }
  resolvedContext    Json

  currentStepIdx     Int      @default(0)
  totalSteps         Int

  /// Free-form failure detail when status='failed'. Includes the partner
  /// status payload that triggered the failure — surfaced to the user.
  failureReason      String?

  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps              BundleStep[]

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("intent_bundles")
}

model BundleStep {
  id                  String   @id @default(cuid())
  bundleId            String
  stepIdx             Int      // 0-based ordering within the bundle

  /// Optional FK to the TransactionIntent (existing model) holding the calldata.
  /// We persist the calldata in TransactionIntent rather than here so the
  /// existing intent infrastructure (PolicyGuard, audit) applies uniformly.
  intentId            String?

  /// Wallet that must sign THIS step. Distinct per step in cross-ecosystem
  /// bundles (Step 0 = srcWallet, Step 1 = dstWallet).
  signerWalletId      String

  /// What this step does:
  ///   'bridge'           → cross-ecosystem transfer via BRIDGE_PARTNER
  ///   'protocol_action'  → supply/borrow/stake/... via WALLET_PARTNER
  ///   'approve'          → ERC-20 approval preceding a protocol action
  stepKind            String

  /// Partner id from PartnerRegistry that routes THIS step.
  partnerId           String

  /// Confirmation requirements before the watcher will advance the bundle:
  ///   { kind: 'across' | 'lifi' | 'squid' | 'evm_confirmations',
  ///     depositTxHash?: string, depositId?: string, minConfirmations?: number }
  confirmationCriteria Json

  /// Hash reported by the frontend after the user's wallet broadcasts.
  txHash              String?
  confirmedAt         DateTime?

  /// Step status FSM:
  ///   'pending'                  no action yet
  ///   'awaiting_user_signature'  ready for the user to sign
  ///   'broadcast'                txHash reported; watcher polls partner status
  ///   'confirmed'                partner confirms; downstream step unlocks
  ///   'failed'                   partner reports failure or revert
  ///   'skipped'                  cancelled before signing
  status              String   @default("pending")

  /// Detail of any failure surfaced from the partner status endpoint.
  failureReason       String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bundle              IntentBundle       @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  intent              TransactionIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull)
  signerWallet        Wallet             @relation("BundleStepSigner", fields: [signerWalletId], references: [id], onDelete: Cascade)

  @@unique([bundleId, stepIdx])
  @@index([status])
  @@index([bundleId, status])
  @@map("bundle_steps")
}

// Strategy Management
model Strategy {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  nodes       Json // Node array for visual flow
  edges       Json // Edge array for connections
  triggers    Json // Trigger configuration
  isActive    Boolean  @default(false)
  riskLevel   String? // low, medium, high
  expectedApy Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  instances     Instance[]
  executions    StrategyExecution[]
  optimizations StrategyOptimization[]

  @@map("strategies")
}

// Strategy Instances (Individual protocol/asset monitoring)
model Instance {
  id          String    @id @default(cuid())
  userId      String
  strategyId  String? // Optional - can be standalone
  name        String
  description String?
  protocol    String // aave, compound, uniswap, moai-finance, etc.
  network     String // ethereum, xrpl, etc.
  asset       String // ETH, XRP, USDT, etc.
  config      Json // Instance-specific configuration
  isActive    Boolean   @default(true)
  lastCheck   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  alerts   Alert[]

  @@map("instances")
}

// Alert System
model Alert {
  id              String        @id @default(cuid())
  userId          String
  walletId        String?
  instanceId      String?
  type            String // price, health_factor, tvl, protocol_risk, liquidation, security, optimization
  priority        String // CRITICAL, HIGH, MEDIUM, LOW
  severity        AlertSeverity @default(INFO)
  triggerType     String? // mirrors TriggerConfig.type (HF_BELOW, OUT_OF_RANGE, ...)
  title           String
  message         String
  data            Json? // Additional alert data
  acknowledged    Boolean       @default(false)
  automationRunId String?
  timestamp       DateTime      @default(now())
  expiresAt       DateTime?

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet?        @relation(fields: [walletId], references: [id], onDelete: SetNull)
  instance      Instance?      @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  automationRun AutomationRun? @relation(fields: [automationRunId], references: [id], onDelete: SetNull)

  @@index([userId, priority, acknowledged])
  @@index([walletId, acknowledged])
  @@map("alerts")
}

enum AlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
  MAX
}

// AI Conversation Management
model AIConversation {
  id             String   @id @default(cuid())
  userId         String
  conversationId String // Groups messages in a conversation
  role           String // user, assistant, system
  message        String   @db.Text
  metadata       Json? // Function calls, context, etc.
  createdAt      DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, conversationId, createdAt])
  @@map("ai_conversations")
}

// Transaction Management
model TransactionConfirmation {
  id        String   @id @default(cuid())
  userId    String
  walletId  String
  action    String // deposit, withdraw, swap, borrow, repay, etc.
  protocol  String
  amount    Float
  asset     String
  priority  String // CRITICAL, HIGH, MEDIUM, LOW
  status    String // pending, approved, rejected, expired
  deadline  DateTime
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, status, priority])
  @@map("transaction_confirmations")
}

model BatchTransactionConfirmation {
  id                String   @id @default(cuid())
  userId            String
  batchType         String // optimization, emergency, strategy, rebalance
  totalAmount       Float
  estimatedTotalGas Int
  priority          String // CRITICAL, HIGH, MEDIUM, LOW
  status            String // pending, approved, rejected, executing, completed, failed
  transactions      Json // Array of transaction data
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, status, priority])
  @@map("batch_transaction_confirmations")
}

model TransactionExecution {
  id         String   @id @default(cuid())
  userId     String
  walletId   String
  action     String
  protocol   String
  amount     Float
  asset      String
  txHash     String? // Blockchain transaction hash
  priority   String
  gasUsed    Int?
  status     String // executed, failed, pending
  metadata   Json?
  executedAt DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, walletId, executedAt])
  @@index([txHash])
  @@map("transaction_executions")
}

// Strategy Execution Tracking
model StrategyExecution {
  id          String    @id @default(cuid())
  strategyId  String
  userId      String
  trigger     String // What triggered the execution
  nodeId      String? // Which node was executed
  status      String // running, completed, failed, interrupted
  context     Json? // Execution context data
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  error       String?

  // Relations
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, status, startedAt])
  @@map("strategy_executions")
}

// AI Strategy Optimization
model StrategyOptimization {
  id                  String    @id @default(cuid())
  strategyId          String
  userId              String
  type                String // ai_suggestion, user_requested, automatic
  currentPerformance  Json // Current strategy metrics
  suggestedChanges    Json // AI suggestions
  expectedImprovement Float? // Expected gain increase percentage
  riskReduction       Float? // Expected risk reduction percentage
  status              String // pending, approved, rejected, implemented
  implementedAt       DateTime?
  createdAt           DateTime  @default(now())

  // Relations
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, status, createdAt])
  @@map("strategy_optimizations")
}

// Strategy Sharing System
model SharedStrategy {
  id                 String   @id @default(cuid())
  originalStrategyId String? // Reference to original strategy
  authorId           String
  name               String
  description        String?
  riskLevel          String // low, medium, high
  expectedApy        Float?
  shareType          String // anonymous, with_wallet, with_username
  nodes              Json // Strategy nodes
  edges              Json // Strategy edges
  triggers           Json // Strategy triggers
  isPublic           Boolean  @default(true)
  likes              Int      @default(0)
  uses               Int      @default(0)
  tags               String[] // Searchable tags
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([isPublic, likes])
  @@index([riskLevel, likes])
  @@map("shared_strategies")
}

// Protocol Data Caching
model ProtocolMetrics {
  id              String   @id @default(cuid())
  protocolId      String   @unique
  name            String
  network         String
  tvl             Float
  totalSupply     Float?
  totalBorrow     Float?
  utilizationRate Float?
  averageApy      Float?
  healthStatus    String // healthy, warning, critical
  lastUpdate      DateTime @default(now())
  metadata        Json? // Additional protocol-specific data

  @@index([protocolId, lastUpdate])
  @@map("protocol_metrics")
}

// Price Data Caching
model PriceData {
  id         String   @id @default(cuid())
  symbol     String   @unique
  price      Float
  change24h  Float?
  volume24h  Float?
  marketCap  Float?
  source     String // coingecko, binance, defillama
  lastUpdate DateTime @default(now())

  @@index([symbol, lastUpdate])
  @@map("price_data")
}

// User Position Tracking
model UserPosition {
  id               String   @id @default(cuid())
  userId           String
  protocol         String
  network          String
  asset            String
  amount           Float
  value            Float
  type             String // lending, borrowing, liquidity, staking, farming
  apy              Float?
  healthFactor     Float?
  liquidationPrice Float?
  lastUpdate       DateTime @default(now())
  metadata         Json?

  @@unique([userId, protocol, network, asset, type])
  @@index([userId, protocol])
  @@map("user_positions")
}

// System Monitoring
model SystemMetrics {
  id         String   @id @default(cuid())
  metricType String // performance, usage, errors, alerts
  metricName String
  value      Float
  unit       String? // percentage, count, milliseconds, etc.
  tags       Json? // Additional tags for filtering
  timestamp  DateTime @default(now())

  @@index([metricType, metricName, timestamp])
  @@map("system_metrics")
}

// API Usage Tracking
model ApiUsage {
  id           String   @id @default(cuid())
  userId       String? // Null for public API usage
  endpoint     String
  method       String // GET, POST, PUT, DELETE
  statusCode   Int
  responseTime Int // in milliseconds
  ipAddress    String
  userAgent    String?
  timestamp    DateTime @default(now())

  @@index([userId, timestamp])
  @@index([endpoint, timestamp])
  @@map("api_usage")
}

// Security Events
model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String?
  eventType   String // suspicious_activity, failed_login, wallet_freeze, emergency_action
  severity    String // low, medium, high, critical
  description String
  ipAddress   String?
  userAgent   String?
  metadata    Json? // Additional event data
  timestamp   DateTime @default(now())

  @@index([userId, eventType, severity, timestamp])
  @@map("security_events")
}

// Background Jobs
model BackgroundJob {
  id          String    @id @default(cuid())
  jobType     String // strategy_execution, data_sync, optimization, cleanup
  status      String // queued, running, completed, failed, cancelled
  priority    Int       @default(0) // Higher number = higher priority
  payload     Json? // Job parameters
  result      Json? // Job results
  error       String? // Error message if failed
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, priority, scheduledAt])
  @@map("background_jobs")
}

// Configuration Management
model Configuration {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  isSystem    Boolean  @default(false) // System vs user-configurable
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("configurations")
}

// Notification Management
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // alert, optimization, transaction, system
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false)
  channel   String // websocket, email, push
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// Rate Limiting
model RateLimit {
  id          String   @id @default(cuid())
  identifier  String // IP address, user ID, API key
  endpoint    String
  requests    Int      @default(1)
  windowStart DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([identifier, endpoint])
  @@index([identifier, windowStart])
  @@map("rate_limits")
}

// Audit Trail
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // login, logout, create_strategy, execute_transaction, etc.
  resource  String? // strategy_id, wallet_id, etc.
  oldValues Json? // Previous state
  newValues Json? // New state
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([userId, action, timestamp])
  @@index([resource, timestamp])
  @@map("audit_logs")
}

// Feature Flags
model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isEnabled   Boolean  @default(false)
  conditions  Json? // Conditions for enabling (user segments, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

// Session Management
model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  refreshToken   String?  @unique // SHA-256 hash of refresh token (email+pw auth)
  ipAddress      String
  userAgent      String?
  isActive       Boolean  @default(true)
  lastActivity   DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([userId, isActive])
  @@index([token, expiresAt])
  @@map("sessions")
}

// Webhook Management
model Webhook {
  id            String    @id @default(cuid())
  userId        String
  url           String
  events        String[] // Array of event types to listen for
  secret        String // For webhook signature verification
