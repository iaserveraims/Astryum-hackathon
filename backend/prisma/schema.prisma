  fiatAmount              Decimal?  // 500
  fiatCurrency            String?   // EUR
  destinationAddress      String    // 0x123abc...
  destinationChainId      Int       // 14 (Flare) or 1 (Ethereum) or ...

  // MiCA compliance flags (immutable, validated at creation)
  partnerExecutes         Boolean   @default(true)      // NOT user, NOT DeFiBro
  defibroExecutes         Boolean   @default(false)     // ALWAYS false
  defibroCustody          Boolean   @default(false)     // ALWAYS false
  defibroOrderTransmission Boolean @default(false)     // ALWAYS false

  // User action tracking
  userConfirmedInsidePartner Boolean @default(false)
  partnerTermsAccepted    Boolean   @default(false)

