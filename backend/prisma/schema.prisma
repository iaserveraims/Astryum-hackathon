  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address, chainType])
  @@index([userId, isActive])
  @@map("wallet_bindings")
}

// The governed-account registry — the authority switcher's server-side list.
// A row is a POINTER the user placed (the old localStorage observed list, made
// portable across devices): which council-governed accounts this user governs
// or observes. The account's state (council, quorum, health) is always read
// fresh from the ledger — Astryum stores nothing about the account itself, so
// losing this table loses only pointers, never governance state.
// `ecosystem` is 'xrpl' today; the column exists so an authority that governs
// executor accounts on other chains (PMW vision, gated) fits without redesign.
model GovernedAccount {
  id        String    @id @default(cuid())
  userId    String
  ecosystem String    @default("xrpl")
  address   String
  label     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  removedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ecosystem, address])
  @@index([userId])
  @@map("governed_accounts")
}

// A council proposal — the persisted unit of governed-mode work. Quorum
// governance is ASYNC by nature (compose → propose → collect signatures →
// combine → broadcast; hours or days), so the collection state must outlive a
// browser tab. Astryum persists the PINNED UNSIGNED tx and the members'
// verified signed blobs — public transaction material destined for the ledger,
// never keys. Combining and broadcasting stay in the members' browsers
// (prepare-only invariant; the server's broadcast path stays hard-blocked).
// One live proposal per account: the pinned Sequence goes stale the moment any
// other tx from the account validates, so parallel proposals would lie.
model CouncilProposal {
  id              String   @id @default(cuid())
  account         String   // the council-governed XRPL account (r…)
  createdByUserId String?  // app-account of the proposer (for withdraw rights)
  title           String?  // short human summary shown in the inbox
  txType          String   // Payment | EscrowCreate | SignerListSet | DIDSet…
  txjson          Json     // pinned unsigned multisig tx (Sequence/Fee/SigningPubKey)
  quorum          Int
  signerList      Json     // [{account, weight}] snapshot at proposal time
  status          String   @default("collecting") // collecting | ready | submitted | expired | withdrawn
  txHash          String?  // reported by the broadcasting browser after submit
  positionsAnchor String?  // batch anchor of the formal positions (set at emission)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime // proposals always expire — a pinned Sequence goes stale anyway

  signatures CouncilProposalSignature[]
  positions  CouncilFormalPosition[]

  @@index([account, status])
  @@map("council_proposals")
}

// One member's verified signature over a proposal's exact pinned tx. Stored
// only after XrplBlobVerifier passes (identity + fidelity + signature): a blob
// signed by the wrong member, or over a drifted tx, never lands here.
model CouncilProposalSignature {
  id            String   @id @default(cuid())
  proposalId    String
  signerAccount String   // the member's r-address
  weight        Int
  blobHex       String   // the member's signed blob (public tx material)
  signedAt      DateTime @default(now())

  proposal CouncilProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, signerAccount])
  @@map("council_proposal_signatures")
}

// A member's FORMAL POSITION on a proposal — the deliberative record (the
// acta, NOT a chat): stance + optional brief comment, signed with the member's
// wallet. Eternal by design, unlike deliberation (which is ephemeral and never
// touches the ledger). The SET of positions is anchored on-chain in batch at
// emission (positionsAnchor above) — each position's own signature makes
// forgery impossible in the meantime; the batch anchor only defers the public
// timestamp, not integrity.
model CouncilFormalPosition {
  id            String   @id @default(cuid())
  proposalId    String
  memberAccount String   // the member's r-address
  stance        String   // for | against | abstain | request-changes
  comment       String?  // brief, optional — part of the signed content
  contentHash   String   // sha256 of the canonical position payload
  signature     String   // hex signature by the member's wallet over contentHash
  signingPubKey String   // the key that produced it (verification evidence)
  createdAt     DateTime @default(now())

  proposal CouncilProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, memberAccount])
  @@map("council_formal_positions")
}

// V1.1 DeFi Position Detection — Detect positions on any chain
model DeFiPosition {
  id                String    @id @default(cuid())
  watchlistId       String
  chainId           Int
  protocol          String    // 'kinetic' | 'sparkdex' | 'firelight' | 'aave' | etc.
  contractAddress   String
  contractType      String    // 'lending' | 'lp' | 'staking' | 'bridge'
  asset             String
  amount            Decimal
  valueUSD          Decimal   @default(0)
  confidenceScore   Int       @default(100)  // 0-100, 100 = exact, <30 = unknown
  confidenceLevel   String    @default("verified") // verified | probable | detected | unknown
  sourceProvider    String    @default("internal")
  metrics           Json?     // HF, LTV, APY, IL, etc.
  riskLevel         String?   // safe | medium | risky | critical
  detectedAt        DateTime
  lastUpdatedAt     DateTime  @updatedAt

  // Relations
  watchlist         WalletWatchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@index([watchlistId, chainId, protocol])
  @@index([chainId, confidenceScore])
  @@map("defi_positions")
}

// V1.1 S2 — Known protocol contracts discovered from DefiLlama or internal registry
model ProtocolContract {
  id              String   @id @default(cuid())
  providerId      String   // 'defillama' | 'internal'
  protocolSlug    String   // e.g. 'aave-v3'
  protocolName    String
