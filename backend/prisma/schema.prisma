  chainName       String
  contractAddress String
  category        String   // 'Lending' | 'DEX' | 'Yield' | 'Staking' | etc.
  auditCount      Int      @default(0)
  auditLinks      Json?    // Array of audit report URLs
  sourceUrl       String?
  trustLevel      String   @default("indexer_verified")
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([chainId, contractAddress])
  @@index([chainId])
  @@index([protocolSlug])
  @@index([contractAddress])
  @@map("protocol_contracts")
}

// V1.1 S2 — Wallet interacted with known or suspected DeFi contract
// Does NOT mean open position — only historical interaction detected
model DeFiInteraction {
  id               String   @id @default(cuid())
  watchlistId      String
  chainId          Int
  protocol         String
  contractAddress  String
  txHash           String
  interactionType  String   // 'supply' | 'borrow' | 'swap' | 'stake' | 'approve' | 'unknown'
  confidenceScore  Int      @default(50) // 0-100
  confidenceLevel  String   @default("detected") // verified | probable | detected
  sourceProvider   String   // 'flarescan' | 'etherscan' | 'defillama'
  firstSeenAt      DateTime
  lastSeenAt       DateTime
  createdAt        DateTime @default(now())

  // Relations
  watchlist        WalletWatchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, txHash, contractAddress])
  @@index([watchlistId, chainId])
  @@index([watchlistId, protocol])
  @@index([chainId, protocol])
  @@map("defi_interactions")
}

// V1.1 S4 — Unsigned transaction prepared by DeFiBro for user-controlled wallet to sign.
// DeFiBro never signs. Source wallet must be user-controlled (NEVER a partner/MoonPay wallet).
model WalletIntent {
  id            String   @id @default(cuid())
  userId        String
  walletAddress String   // source wallet — must be registered by user
  chainId       Int
  to            String   // target contract address
  calldata      String   @db.Text
  value         String   @default("0")  // wei, serialized bigint
  gasLimit      String   // estimated gas limit, serialized bigint
  nonce         Int?
  status        String   @default("draft")  // draft | ready | signed | confirmed | failed
  sourceIntentId String? // optional link to PartnerIntent that triggered this
  fee           String?  // estimated fee in native token, serialized Decimal
  feeAsset      String?
  note          String?  // human-readable description shown to user
  txHash        String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
  @@index([walletAddress, chainId])
  @@map("wallet_intents")
}

// V1.1 S5 — User-defined trigger rules evaluated by IntentTriggerService.
// Triggers NOTIFY only — never auto-open MoonPay, never auto-execute anything.
model TriggerRule {
  id                   String    @id @default(cuid())
  userId               String
  name                 String
  description          String?
  enabled              Boolean   @default(true)

  // Condition discriminated by conditionType; params validated by Zod at service layer
  // Values: 'PRICE_BELOW' | 'PRICE_ABOVE' | 'BALANCE_BELOW' | 'POSITION_VALUE_BELOW'
  //       | 'DEFI_POSITION_DETECTED' | 'onchain_event' | 'wallet_activity' | 'schedule'
  conditionType        String
  conditionParams      Json      // { asset?, threshold?, chainId?, contractAddress?, eventSignature?, walletAddress?, ... }

  notificationTemplate String?   // optional custom notification message template

  // Suggested action when the rule fires (confirmed by user via /confirm endpoint)
  // Values: 'notify_only' | 'swap' | 'transfer' | 'moonpay_buy'
  suggestedActionType   String?
  suggestedActionParams Json?    // action-specific params: { fromToken, toToken, amount?, ... }

  // Last processed block for onchain_event rules (prevents re-processing old events)
  lastProcessedBlock   BigInt?

  cooldownMinutes      Int       @default(60)
  lastFiredAt          DateTime?
  timesTriggered       Int       @default(0)

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@map("trigger_rules")
}

model ProtocolPool {
  id               String   @id
  contractAddress  String?
  chain            String               // CAIP-2 e.g. "eip155:14"
  chainId          Int
  protocol         String
  protocolName     String
  symbol           String
  tvlUsd           Float    @default(0)
  apyBase          Float?
  apyReward        Float?
  apyTotal         Float    @default(0)
  underlyingTokens Json     @default("[]")
  rewardTokens     Json     @default("[]")
  category         String?
  isLiquidStaking  Boolean  @default(false)
  ltv              Float?
  ilRisk           String?
  url              String?
  isAudited        Boolean  @default(false)
  isAllowlisted    Boolean  @default(false)
  cooldownSeconds  Int?
  feeType          String?
  referralCode     Int?
  // Borrow-side data from DefiLlama /yields/poolsBorrow
  // Present only for pools where borrowing is supported (Aave, Compound, Morpho, etc.)
  apyBaseBorrow    Float?
  apyRewardBorrow  Float?
  totalSupplyUsd   Float?
  totalBorrowUsd   Float?
  debtCeilingUsd   Float?
  borrowable       Boolean  @default(false)

  // ─── Block F (2026-06-01) — ContractRegistry fields ─────────────────────
  // Distinguishes receipt token (what DefiLlama returns) from interaction
  // contract (what CalldataBuilder uses). Resolved by ABIResolver via the
  // contractResolvers per-kind pipeline.

  /// On-chain contract the user actually calls. Distinct from receiptTokenAddress
  /// when DefiLlama returns a token (e.g. aToken instead of Aave Pool).
  interactionContractAddress  String?

  /// Receipt / share / LP token address as returned by DefiLlama. May equal
  /// interactionContractAddress when the receipt IS the interaction contract.
  receiptTokenAddress         String?

  /// Architectural family. Drives ABI selection + method dispatch in CalldataBuilder.
  /// Values: 'aave_v3_pool' | 'aave_v2_pool' | 'comet_v3' | 'lido_steth' |
  ///         'rocket_pool_deposit' | 'sceptre_vault' | 'erc4626_vault' |
  ///         'uniswap_v3_nfpm' | 'curve_pool' | 'morpho_blue' | 'spark_pool' |
  ///         'balancer_v2_vault' | 'unknown'
  contractKind                String?

  /// Morpho Blue market params (loanToken/collateralToken/oracle/irm/lltv + id).
  /// Morpho's borrow/supply calldata needs the full MarketParams struct, which
  /// is NOT derivable from the DefiLlama UUID. Resolved server-side and stored
  /// here so the frontend never has to know it. Null until resolved (Tier B).
  morphoMarketParams          Json?

  /// Resolved ABI for interactionContractAddress (JSON array).
  abi                         Json?
  /// Provenance: 'defillama_decoder' | 'etherscan_v2' | 'sdk_official' |
  ///             'manual_fallback' | 'protocolcontracts_legacy' | 'unresolved'
  abiSource                   String?
  abiResolvedAt               DateTime?
  abiResolutionAttempts       Int      @default(0)
  abiResolutionLastError      String?

  // Capabilities detected from ABI introspection + DefiLlama data shape.
  // CalldataBuilder dispatches on these booleans, not on protocol slug.
  supportsSupply              Boolean  @default(false)
  supportsWithdraw            Boolean  @default(false)
  supportsBorrowCapability    Boolean  @default(false) // distinct from `borrowable` (the pool offering)
  supportsRepay               Boolean  @default(false)
  supportsStake               Boolean  @default(false)
  supportsUnstake             Boolean  @default(false)
  supportsAddLiquidity        Boolean  @default(false)
  supportsRemoveLiquidity     Boolean  @default(false)
  supportsVaultDeposit        Boolean  @default(false)
  supportsVaultWithdraw       Boolean  @default(false)

  /// EIP-1967 proxy detection — triggers re-verification when implementation changes.
  isUpgradeable               Boolean  @default(false)

  /// Active = CalldataBuilder will produce a real intent for this pool.
  /// Inactive = pool stays visible (read-only) but execution is blocked.
  isActive                    Boolean  @default(true)
  inactiveReason              String?

  /// Last on-chain probe to verify the contract still matches the stored ABI.
  lastVerifiedAt              DateTime?

  lastSyncedAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([chainId, apyTotal])
  @@index([isAllowlisted, chainId])
  @@index([borrowable, chainId])
  @@index([isActive, chainId])
  @@index([contractKind])
  @@index([interactionContractAddress, chainId])
  @@map("protocol_pools")
}

model IntentAuthorizationSession {
  id                 String                           @id @default(cuid())
  userId             String
  intentPayloadId    String
  status             IntentAuthorizationSessionStatus @default(pending_user_review)
  payloadHash        String
  authorizationProof Json?
  // authorizationProof = { signedPayloadHash, signedAt, walletAddress, signatureScheme }
  // NO txHash — DeFiBro does not receive or process broadcast results
  cancelReason       String?
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("intent_authorization_sessions")
}

// V2 P10.5 — Dynamically integrated protocol execution configs.
// Powers CalldataBuilder for protocols not in the static protocolContracts.ts registry.
// Admin integrates a protocol once via POST /api/admin/protocols/integrate; ABI is auto-fetched.
model ProtocolContractRecord {
  id            String   @id @default(cuid())
  slug          String   // DefiLlama protocol slug e.g. 'curve-dex'
  chainId       Int
  address       String
  abi           Json     // ABI array (fetched from DefiLlama or Etherscan)
  actions       Json     // { supply: { fn, args, isPayable? }, unstake: {...}, ... }
  feeType       String   @default("none")  // referral_code | referrer_address | revenue_share | none
  referralValue String?  // numeric code or wallet address
  cooldownDays  Int?     // LST unstake cooldown days
  source        String   @default("manual")  // manual | defillama | etherscan
  addedAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([slug, chainId])
  @@index([slug])
  @@index([address])
  @@map("protocol_contract_records")
}

// P6.3 — Address Book for wallet-to-wallet transfers
model AddressBookEntry {
  id        String   @id @default(cuid())
  userId    String
  label     String
  address   String
  chainId   Int?
  ens       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, address, chainId])
  @@index([userId])
  @@map("address_book_entries")
}

// ─── P-AGENT-1: AI Agent System ──────────────────────────────────────────────

model AgentConversation {
  id        String         @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  AgentMessage[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // 'user' | 'assistant'
  content        String   @db.Text
  mcpToolCalls   Json?    // tools used in this message + results
  createdAt      DateTime @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

model AgentDocument {
  id          String   @id @default(cuid())
  userId      String
  filename    String
  contentType String   // 'pdf' | 'txt' | 'md' | 'json'
  content     String   @db.Text // extracted text
  sizeBytes   Int
  source      String   @default("user_upload") // 'user_upload' | 'defibro_report' | 'defibro_audit'
  uploadedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, uploadedAt])
  @@map("agent_documents")
}

model AgentRule {
  id              String    @id @default(cuid())
  userId          String
  name            String
  description     String?
  triggerType     String    // 'schedule' | 'app_open' | 'price_threshold' | 'portfolio_change' | 'market_event' | 'manual'
  triggerConfig   Json      // type-specific params
  prompt          String    @db.Text // what the agent runs when triggered
  outputChannel   String    @default("both") // 'chat' | 'notification' | 'both'
  isActive        Boolean   @default(true)
  mcpServersReq   String[]  @default([]) // which MCPs this rule needs
  createdAt       DateTime  @default(now())
  lastTriggeredAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("agent_rules")
}

model UserMCPConnection {
  id          String   @id @default(cuid())
  userId      String
  serverId    String   // catalog id: 'coinglass' | 'santiment' | etc.
  serverName  String
  serverUrl   String?  // custom URL for non-catalog servers
  apiKeyEnc   String?  // AES-256-GCM encrypted API key if required
  isActive    Boolean  @default(true)
  connectedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([userId, isActive])
  @@map("user_mcp_connections")
}

model UserAnthropicKey {
  id         String    @id @default(cuid())
  userId     String    @unique
  keyEnc     String    // AES-256-GCM encrypted Anthropic API key
  model      String    @default("claude-haiku-4-5") // user-chosen model
  addedAt    DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_anthropic_keys")
}

// ─────────────────────────────────────────────────────────────────────────────
// P-GOALS-LAYER
// ─────────────────────────────────────────────────────────────────────────────

model GoalRequest {
  id                String    @id @default(cuid())
  userId            String
  // Original natural-language text from the user
  rawText           String    @db.Text
  // Parsed structured fields (AI output)
  targetMonthlyUSD  Float
  riskTolerance     String    // 'low' | 'medium' | 'high'
  timeHorizon       String?   // e.g. '6_months' | '1_year' | '3_years' | 'indefinite'
  // Snapshot of the user's capital at the moment the goal was created
  capitalSnapshot   Json      // CapitalMap-shaped summary stored as JSON
  // 'open' = visible to matching managers, 'targeted' = sent to specific managers only
  mode              String    @default("open")    // 'open' | 'targeted'
  targetManagerIds  String[]  @default([])        // used in 'targeted' mode
  status            String    @default("active")  // 'active' | 'fulfilled' | 'closed'
  // Feasibility output cached from FeasibilityAnalyzer
  feasible          Boolean?
  requiredAPY       Float?
  realisticMonthlyUSD Float?
  feasibilityNote   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  closedAt          DateTime?

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposals ManagerProposalV1[]
  fullProposals ManagerProposal[]

  @@index([userId, status])
  @@map("goal_requests")
}

// Minimal manager filter for P-GOALS-LAYER.
// References userId directly (a user opts in as a manager by creating one of these).
// P-DELEGATION will extend this with ManagerProfile.
model ManagerFilter {
  id                    String   @id @default(cuid())
  userId                String   @unique // the manager
  minCapitalUSD         Float    @default(0)
  maxCapitalUSD         Float?
  acceptedRiskLevels    String[] @default(["low","medium","high"])
  preferredChains       Int[]    @default([])  // empty = all chains
  maxActiveDelegations  Int      @default(10)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@map("manager_filters")
}

// Lightweight proposal model for P-GOALS-LAYER.
// Full ManagerProposal model lives in P-DELEGATION.
model ManagerProposalV1 {
  id            String   @id @default(cuid())
  goalRequestId String
  managerId     String   // userId of the manager
  strategy      String   @db.Text  // free-form strategy description
  feeModel      String?  // e.g. '1% AUM' | '10% performance'
  aiExplanation String?  @db.Text  // AI-generated explanation for the user
  status        String   @default("pending")  // 'pending' | 'accepted' | 'rejected'
  createdAt     DateTime @default(now())

  goalRequest GoalRequest @relation(fields: [goalRequestId], references: [id], onDelete: Cascade)

  @@index([goalRequestId, status])
  @@index([managerId])
  @@map("manager_proposals_v1")
}

// ─────────────────────────────────────────────────────────────────────────────
// P-DELEGATION
// ─────────────────────────────────────────────────────────────────────────────

model ManagerProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  displayName       String
  bio               String?   @db.Text
  licenseType       String    @default("individual") // 'individual' | 'registered_advisor' | 'institutional'
  kycAt             DateTime?
  isActive          Boolean   @default(true)
  // P-GROWTH: application workflow
  status            String    @default("active") // 'pending_kyc' | 'pending_approval' | 'active' | 'rejected' | 'suspended'
  applicationNote   String?   @db.Text
  approvedAt        DateTime?
  approvedBy        String?
  isFoundingManager Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackRecords   TrackRecord[]
  batchProposals BatchProposal[]
  referral       ManagerReferral?

  @@index([isActive])
  @@index([status])
  @@map("manager_profiles")
}

// P-GROWTH: referral link per manager
model ManagerReferral {
  id         String   @id @default(cuid())
  managerId  String   @unique // FK to ManagerProfile.userId
  code       String   @unique
  clickCount Int      @default(0)
  createdAt  DateTime @default(now())

  manager     ManagerProfile       @relation(fields: [managerId], references: [userId], onDelete: Cascade)
  conversions ReferralConversion[]

  @@map("manager_referrals")
}

// P-GROWTH: tracks conversion funnel for each referred user
model ReferralConversion {
  id             String    @id @default(cuid())
  referralId     String
  referredUserId String?   @unique // userId once registered
  goalRequestId  String?
  mandateId      String?
  stage          String    // 'registered' | 'goal_created' | 'delegation_accepted' | 'first_yield'
  payoutUSD      Float?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  referral ManagerReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@index([referredUserId])
  @@map("referral_conversions")
}

model ManagerProposal {
  id               String    @id @default(cuid())
  goalRequestId    String
  managerId        String    // userId of the manager
  // Rich strategy description + rationale
  strategy         String    @db.Text
  // Array of IntentPayload-shaped objects (unsigned calldata the manager plans to use)
  primaryIntents   Json
  feeModel         String?   // e.g. '1% AUM' | '10% performance'
  aiExplanation    String?   @db.Text
  // Proposed DelegationMandate parameters
  proposedMandate  Json      // { allowedProtocols, maxCapitalUSD, durationDays }
  status           String    @default("pending") // 'pending' | 'accepted' | 'rejected' | 'withdrawn'
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  goalRequest      GoalRequest       @relation(fields: [goalRequestId], references: [id], onDelete: Cascade)
  backupStrategy   BackupStrategy?
  mandate          DelegationMandate?

  @@index([goalRequestId, status])
  @@index([managerId])
  @@map("manager_proposals")
}

model BackupStrategy {
  id                 String   @id @default(cuid())
  proposalId         String   @unique
  // Array of trigger configs: { type, threshold, asset?, chainId? }
  triggers           Json
  // Array of IntentPayload-shaped defensive actions (e.g. repay if HF < 1.3)
  defensiveIntents   Json
  // 'pre_auth' = user signs a conditional authorization upfront
  // 'notify'   = DeFiBro sends push notification, user signs on demand
  activationMode     String   @default("notify") // 'pre_auth' | 'notify'
  preAuthExpiryDays  Int      @default(30)
  createdAt          DateTime @default(now())

  proposal               ManagerProposal          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  conditionalAuthorizations ConditionalAuthorization[]

  @@map("backup_strategies")
}

model ConditionalAuthorization {
  id               String    @id @default(cuid())
  userId           String
  backupStrategyId String
  signedAt         DateTime  @default(now())
  expiresAt        DateTime
  // 'active' | 'expired' | 'used' | 'revoked'
  status           String    @default("active")
  revokedAt        DateTime?
  lastRenewedAt    DateTime?

  backupStrategy   BackupStrategy @relation(fields: [backupStrategyId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([backupStrategyId])
  @@map("conditional_authorizations")
}

model DelegationMandate {
  id               String    @id @default(cuid())
  userId           String
  managerId        String
  proposalId       String    @unique
  // Protocols the manager is allowed to act on behalf of the user
  allowedProtocols String[]
  // Hard cap in USD that the manager can move per action
  maxCapitalUSD    Float
  // 'active' | 'paused' | 'revoked'
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?

  user             User              @relation("UserMandates", fields: [userId], references: [id], onDelete: Cascade)
  manager          User              @relation("ManagerMandates", fields: [managerId], references: [id], onDelete: Cascade)
  proposal         ManagerProposal   @relation(fields: [proposalId], references: [id])
  auditEntries     DelegationAuditEntry[]

  @@index([userId, status])
  @@index([managerId, status])
  @@map("delegation_mandates")
}

model TrackRecord {
  id                   String   @id @default(cuid())
  managerId            String
  period               String   // e.g. '2026-05' (YYYY-MM)
  apy                  Float    @default(0)
  backupActivations    Int      @default(0)
  capitalPreservedRate Float    @default(1) // 1.0 = 100% capital preserved
  zeroLiquidations     Boolean  @default(true)
  clientRetention      Float    @default(1) // fraction of clients retained
  clientCount          Int      @default(0)
  computedAt           DateTime @default(now())

  manager              ManagerProfile @relation(fields: [managerId], references: [userId], onDelete: Cascade)

  @@unique([managerId, period])
  @@index([managerId])
  @@map("track_records")
}

model DelegationAuditEntry {
  id              String   @id @default(cuid())
  mandateId       String
  action          String   // 'intent_prepared' | 'intent_signed' | 'mandate_created' | 'mandate_revoked' | 'backup_triggered'
  by              String   // userId (manager or user)
  timestamp       DateTime @default(now())
  intentId        String?
  onChainVerified Boolean  @default(false)
  metadata        Json?

  mandate         DelegationMandate @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@index([mandateId])
  @@index([by])
  @@map("delegation_audit_entries")
}

model BatchProposal {
  id            String   @id @default(cuid())
  managerId     String
  // The base strategy template used for all proposals in this batch
  templateData  Json
  // goalRequestIds that this batch was sent to
  targetGoalIds String[]
  sentCount     Int      @default(0)
  acceptedCount Int      @default(0)
  status        String   @default("draft") // 'draft' | 'sent' | 'completed'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  manager       ManagerProfile @relation(fields: [managerId], references: [userId], onDelete: Cascade)

  @@index([managerId])
  @@map("batch_proposals")
}

model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  // Which door the visitor came through: 'early-access' | 'demo' | 'legacy',
  // plus 'register' (auto-enrolment on account creation) and 'admin' (email
  // approved by a founder that never signed the public form).
  source    String   @default("early-access")
  lang      String?
  createdAt DateTime @default(now())

  // Beta gate (founder 2026-08-01, opening 08-06): with BETA_REGISTRATION_OPEN
  // unset, an account can ONLY be created by an email a founder approved.
  // approvedAt = the approval instant (null = still waiting). invitedAt = when
  // the boarding-pass email last went out (null = never sent). Existing
  // accounts are untouched — the gate guards CREATION, never login.
  approvedAt DateTime?
  invitedAt  DateTime?

  @@index([createdAt])
  @@map("waitlist_signups")
}
