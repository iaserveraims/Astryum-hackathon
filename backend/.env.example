# OPTIONAL: without SOROSWAP_API_KEY the provider self-disables. API keys start
# with `sk_`. The provider returns an UNSIGNED XDR; the user signs in their
# Stellar wallet (Freighter/Lobstr) — Astryum never signs. referralId fee →
# SOROSWAP_FEE_WALLET (Stellar G… address) or ASTRYUM_FEE_WALLET.
# SOROSWAP_API_KEY=     # real key goes in backend/.env (gitignored), NEVER here
# SOROSWAP_FEE_BPS=30
# SOROSWAP_FEE_WALLET=
