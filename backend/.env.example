# Flare DeFi stack visibility. S2/MVP default: hidden until grants.
FLARE_DEFI_ENABLED=false

# XRPL native DeFi builders (escrow/DEX/AMM prepare-only endpoints,
# /api/xrpl-defi). Invariant #10: nothing plugs in without its flag.
XRPL_DEFI_ENABLED=false

# ── Demo cap (open MVP / judge phase) — radius limiter, NOT a stranding guard ──
# The open app lets anyone sign real mint txns; these BOUND the blast radius of a batch
# that reverts (stranded XRP has no reclaim — pre-sign simulation, invariant #12 / R8,
# is the real fix). All FAIL-CLOSED: missing/malformed value => protection ON.
# max XRP per mint tx. Env-changeable: read fresh per request, so a Railway change takes
# effect on the next redeploy (restart) — no code change. Must be > 0.3 (the fee floor).
DEMO_MAX_XRP_PER_TX=1
# per-address daily XRP volume, PERSISTED across redeploys (background_jobs). Calibrated:
# 0xFE budget 120 − 40 Legacy reserve = 80 FLR/day ÷ ~20 FLR/mint ≈ 4 mints/day TOTAL;
# 2/addr = 2 mints ≈ 40 FLR so two addresses fit the window (old default 5 = 100 FLR busts it).
DEMO_MAX_XRP_PER_ADDRESS_PER_DAY=2
# ~FLR the executor spends attesting one mint — the §3 budget pre-check anchor.
DEMO_ESTIMATED_MINT_FEE_FLR=20
# Explicit exempt lists (team demo), comma-separated, case-insensitive. NEVER the
# execution allowlist: opening the app relaxes that list and would silently exempt everyone.
# PREFERRED — by ACCOUNT (login email): exempts every wallet the account pays from; the
# identity comes from the session JWT (unforgeable client-side). Deliberately NOT
# ADMIN_EMAILS: panel access and cap exemption are different powers.
DEMO_CAP_EXEMPT_EMAILS=
# Fallback — by address (wallets without an account). The body address is client-claimed.
DEMO_CAP_EXEMPT_ADDRESSES=

# Pipeline 2.6 (Opción A) — persist aggregated Position + PositionSnapshot rows
