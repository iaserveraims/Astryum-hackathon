# XRPL - XRP Ledger
# NO pongas xrplcluster.com: responde 402 Payment Required a IPs de datacenter
# (Railway y cualquier hosting) y rota nodos amendment-blocked en su pool. El
# código rota a s1/s2 igualmente, pero fijarlo aquí paga un salto muerto por
# lectura. Déjalo vacío para usar los defaults sanos (s1 → s2 → cluster).
XRPL_RPC_URL=https://s1.ripple.com:51234
XRPL_TESTNET_RPC=wss://s.altnet.rippletest.net:51233
# Make Waves project SourceTag (UInt32) — ASSIGNED to Astryum by the XRPL
# Commons / Make Waves panel ("Add this source tag to your XRPL mainnet
# transactions so your on-chain activity counts toward the leaderboard").
# NOT a secret: it is public on the ledger. EVERY XRPL tx Astryum composes
# carries it (config/xrplSourceTag.ts); when unset the backend logs a warning
# on first compose — an untagged tx does not count for the leaderboard.
XRPL_SOURCE_TAG=2607090002

