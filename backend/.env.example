# Morpho Blue markets enumerated by the position scanner (comma-separated
# bytes32 ids; Morpho markets are isolated — a user's markets are not
# enumerable on-chain). The two Base (8453) ids are the cbXRP/USDC markets
# behind Coinbase's XRP-backed loans — verified via blue-api.morpho.org:
# 0xd4a903… lltv 62.5% ($82M coll.) · 0xfdfecf… lltv 77% ($0.9M).
# El PRIMERO es el par FXRP/RLUSD de Ethereum (chain 1) — el mercado del
# carril W3/W5, verificado on-chain (colateral FXRP 6 dec · préstamo RLUSD
# 18 · LLTV 0,77). Sin él, el escáner de posiciones NUNCA enumera el mercado
# del carril y la posición no aparece aunque todo lo demás esté bien (H11).
MORPHO_BLUE_MARKET_IDS=0x4fa31e3f8ba345227d44e1cf48559eea53a90dd5311dc006984c060f2f311d96,0xd4a903dc6d949519060c7707f9604fdc9772c046e05c2e3a8fce0bd7196e4109,0xfdfecf85a4dd90a7637ae2aaf28b35061166f0e62bfc714c565eed9f7e959783

# ── Cuenta abstracta en Ethereum: bundler + paymaster (Pimlico) ──────────────
# Para que el usuario opere en Ethereum SIN tener ETH. El bundler transmite el
# userOp que el usuario firma y el paymaster paga el gas; Astryum ni firma ni
# transmite. Verificado on-chain: EIP-7702 vivo en mainnet (1,14% de
# las transacciones de un bloque real), EntryPoint v0.8 desplegado y el
# SingletonPaymaster v0.8 de Pimlico apuntando a él.
#
# SECRETO DE SERVIDOR. La URL del bundler/paymaster LLEVA LA KEY DENTRO, así que
# el frontend NUNCA la ve: el backend hace de proxy del servicio de paymaster
# (ERC-7677). Prohibido NEXT_PUBLIC_* aquí (invariante #2).
#
# Sin key, el carril patrocinado se auto-desactiva y el usuario firma pagando su
# propio gas — degradación honesta, no un fallo.
PIMLICO_API_KEY=     # real key goes in backend/.env (gitignored), NEVER here
# Modo de cobro: 'sponsored' (Astryum patrocina y cobra dentro del lote) o
# 'erc20' (el usuario paga en un token que Pimlico acepte — RLUSD NO está en su
# lista; USDC, USDT, DAI y WETH sí).
PIMLICO_PAYMASTER_MODE=sponsored

# ── Relay de gas en Ethereum: la tarifa ──────────────────────────────────────
# El coste NO puede superar (limites de gas x maxFeePerGas), y eso se conoce al
# cotizar. Se cobra sobre ese techo, asi que el relay no puede perder dinero.
#   comision = max(ETH_RELAY_MIN_FEE_USDC, techo x (1 + ETH_RELAY_MARGIN_PCT/100))
# El SUELO es la palanca de rentabilidad (manda cuando el gas esta barato, que es
# casi siempre); el MARGEN es el seguro para los dias caros.
ETH_RELAY_MIN_FEE_USDC=0.50
ETH_RELAY_MARGIN_PCT=25
ETH_RELAY_MAX_GWEI=2
ETH_RELAY_QUOTE_TTL_SEC=180

# MoonPay regulated partner (S4). All OPTIONAL — adapter self-disables without
# MOONPAY_API_KEY. MoonPay executes inside its flow and sends crypto directly
# to the user's wallet; Astryum never custodies or signs.
MOONPAY_API_KEY=
# sandbox | live (controls buy widget base URL)
# Force-enable the partner in the registry without real keys (tests/staging).
MOONPAY_ENABLED=false

