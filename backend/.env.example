NODE_ENV=development
PORT=3001
HOST=localhost
JWT_SECRET=GENERATE_SECURE_256_BIT_KEY_HERE
# Local development ONLY: return the password-reset token in the /forgot-password
# response (there is no mailer). Ignored when NODE_ENV=production. Leave unset on
# any shared environment (staging included): anyone could reset any password.
# AUTH_EXPOSE_RESET_TOKEN=true

# Security Configuration
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
SESSION_SECRET=GENERATE_SECURE_SESSION_SECRET_HERE

# Rate Limiting

# ============================================================================
# BLOCKCHAIN RPC ENDPOINTS
# ============================================================================

# XRPL - XRP Ledger
# NO pongas xrplcluster.com: responde 402 Payment Required a IPs de datacenter
# (Railway y cualquier hosting) y rota nodos amendment-blocked en su pool. El
# código rota a s1/s2 igualmente, pero fijarlo aquí paga un salto muerto por
# lectura. Déjalo vacío para usar los defaults sanos (s1 → s2 → cluster).
XRPL_RPC_URL=https://s1.ripple.com:51234
XRPL_TESTNET_RPC=wss://s.altnet.rippletest.net:51233
# WebSocket de XRPL para los servicios que FIRMAN y ENVÍAN (autopilot del exchange,
# executor, keepers). Misma advertencia que arriba: wss://xrplcluster.com contesta
# 402 al upgrade desde IPs de datacenter (Railway) y el envío muere con
# «Unexpected server response: 402» (autopilot de staging). Pon s1/s2.
XRPL_WS_URL=wss://s1.ripple.com
# Make Waves project SourceTag (UInt32) — ASSIGNED to Astryum by the XRPL
# Commons / Make Waves panel ("Add this source tag to your XRPL mainnet
# transactions so your on-chain activity counts toward the leaderboard").
# NOT a secret: it is public on the ledger. EVERY XRPL tx Astryum composes
# carries it (config/xrplSourceTag.ts); when unset the backend logs a warning
# on first compose — an untagged tx does not count for the leaderboard.
XRPL_SOURCE_TAG=2607090002

# Emisores de credenciales XLS-70 que ESTA instancia acepta (I2, read-only).
# Lista de r-addresses separadas por comas. Astryum JAMÁS emite credenciales:
# solo lee `account_objects` y comprueba emisor/tipo/expiración. Vacía o sin
# definir ⇒ las credenciales se LEEN y se muestran igual (el ledger es
# público) pero ninguna desbloquea features. Sumsub entra aquí cuando la
# conversación comercial de co-emisión aterrice (ADR-012).
# XRPL_CREDENTIAL_ISSUERS=r...,r...

# Aptos Network
APTOS_RPC_URL=https://fullnode.mainnet.aptoslabs.com/v1

# Flare Network
# El gateway público (flare-api.flare.network) limita por IP y en un PaaS la IP
# de egress es COMPARTIDA: devuelve 429 sin que tú hayas hecho nada raro. Para
# producción pon aquí un nodo dedicado (Ankr, dRPC, rpc.ftso.au...). Esta es la
# variable que leen TODOS los caminos, incluidos FlareProvider y FTSO.
FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc
FLARE_WS_URL=wss://flare-api.flare.network/ext/bc/C/ws

# Interruptor de ops del websocket de Flare. El socket es OPCIONAL: sólo lo usa
# getProvider() como transporte preferente de lectura, y toda lectura cae a HTTP
# sin él (nada en el repo se suscribe a bloques ni a pending txs). Ponlo a false
# si el nodo limita el upgrade y prefieres dejar de intentarlo.
# FLARE_RPC_WS_ENABLED=true

# Explorador de Flare (carril de actividad). OPCIONAL: sin esta variable el
# código ya usa Routescan como principal y el Blockscout de Flare como reserva
# (backend/src/config/flareExplorer.ts). Solo se pone aquí para invertir el
# orden o apuntar a otro indexador; admite lista separada por comas, en orden
# de preferencia. No es un secreto y no lleva clave.
# FLARESCAN_API_URL=https://api.routescan.io/v2/network/mainnet/evm/14/etherscan/api,https://flare-explorer.flare.network/api

