# ====================================================================
# Astryum Backend — PRODUCTION env vars (V2 Master Plan)
# ====================================================================
# Copy to .env on Railway. Do NOT commit real values.
# REQUIRED = backend refuses to boot without it.
# Contract addresses verified 2026-05-23 via docs.kinetic.market + docs.sparkdex.ai
# ====================================================================

# ---- Runtime ----
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ---- Auth (REQUIRED) ----
# Generate: openssl rand -base64 64
JWT_SECRET=                              # REQUIRED
SESSION_SECRET=                          # REQUIRED
ALLOW_NO_AUTH=                           # must stay empty in prod

# ---- SIWE ----
APP_DOMAIN=astryum.xyz
SIWE_URI=https://astryum.xyz

# ---- Email/password account (optional) ----
EMAIL_AUTH_ENABLED=                      # 1 to enable /api/auth/register|login|refresh

# ---- Anti-bot (Cloudflare Turnstile) ----
# Settles the captcha token on login/register/forgot/waitlist/admin-session.
# Unset = check off. Sitekey lives in the frontend (NEXT_PUBLIC_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=

# ---- OAuth (Google / Apple) ----
# id_token audience per provider; unset = provider disabled (503 + placeholder
# button). Full setup: docs/AUTH_SETUP.md.
GOOGLE_OAUTH_CLIENT_ID=                  # …apps.googleusercontent.com
APPLE_OAUTH_CLIENT_ID=                   # the Services ID, e.g. xyz.astryum.web

# ---- Step-up signature locks (optional) ----
# Global kill-switch. When unset, all step-up middleware is a no-op even if a
# user has locks configured. Set to 1 to honor per-user StepUpLockConfig.
STEP_UP_ENABLED=                         # 1 to enable

# ---- Passkey / WebAuthn (optional) ----
# RP ID must equal the site host exactly (no scheme/port); ORIGIN includes scheme.
WEBAUTHN_RP_ID=astryum.xyz
WEBAUTHN_RP_NAME=Astryum
WEBAUTHN_ORIGIN=https://astryum.xyz

# ---- Databases (REQUIRED) ----
DATABASE_URL=                            # REQUIRED — Supabase Transaction Pooler port 6543
                                         # e.g. postgres://user:pass@db.xxx.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=                              # REQUIRED — Supabase Session Pooler port 5432 (for migrate deploy)
REDIS_URL=                               # REQUIRED — redis://host:6379

# ---- CORS ----
CORS_ORIGIN=https://astryum.xyz          # comma-separated if multiple origins

# ---- Rate limiting ----

# ============================================================================
# BLOCKCHAIN RPC
# ============================================================================

# Flare (REQUIRED — primary chain)
FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc
FLARE_WS_URL=wss://flare-api.flare.network/ext/bc/C/ws

# Alchemy (REQUIRED for multichain EVM: ETH, Polygon, Arbitrum, Base, Optimism)
ALCHEMY_API_KEY=

# Helius (REQUIRED for Solana)
HELIUS_API_KEY=

# QuickNode (fallback EVM — optional)
QUICKNODE_ENDPOINT=

# Per-chain RPC overrides (optional — Alchemy used if empty)
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
OPTIMISM_RPC_URL=

# XRPL (optional — déjalo VACÍO y el código usa s1 → s2 → cluster)
# xrplcluster.com devuelve 402 Payment Required a IPs de datacenter: en Railway
# tumbó el watcher 0xFE ("tick failed: Unexpected server response: 402") y deja
# el portfolio a $0 si se fija como primario. Además rota nodos
# amendment-blocked. Si lo pones aquí, vuelve a encabezar la lista.
XRPL_WS_URL=
RLUSD_XRPL_ISSUER=                      # RLUSD issuer address on XRPL mainnet (verify at livenet.xrpl.org)
SOIL_VAULT_ISSUER=                       # Soil vault issuer — empty until Soil mainnet (XLS-66)

# ============================================================================
# PROTOCOL ADDRESSES — Flare Mainnet (verified 2026-05-23)
# ============================================================================

# --- Kinetic Market (Compound-V2 fork) --- source: docs.kinetic.market/contracts-and-api-documentation
KINETIC_COMPTROLLER=0x8041680Fb73E1Fe5F851e76233DCDfA0f2D2D7c8  # Unitroller proxy
KINETIC_LENS=0xcB10E547aB931fe12D3df5BF3f2f9D596Ab1A181

# Kinetic kToken markets (verified 2026-05-23)
KINETIC_KFLR=0xb84F771305d10607Dd086B2f89712c0CeD379407
KINETIC_KUSDCE=0xDEeBaBe05BDA7e8C1740873abF715f16164C29B8
KINETIC_KUSDT=0x1e5bBC19E0B17D7d38F318C79401B3D16F2b93bb
KINETIC_KUSDT0=0x76809aBd690B77488Ffb5277e0a8300a7e77B779

# Set to "true" once KINETIC_COMPTROLLER confirmed in prod (activates KineticAdapter)
FLARE_DEFI_ENABLED=true

# --- SparkDEX (Uniswap V3 fork) --- source: docs.sparkdex.ai/additional-information/smart-contract-overview/v2-v3.1-dex
SPARKDEX_NFPM=0xEE5FF5Bc5F852764b5584d92A4d592A53DC527da    # V3 NonfungiblePositionManager
SPARKDEX_FACTORY=0x8A2578d23d4C532cC9A98FaD91C0523f5efDE652  # V3Factory
SPARKDEX_ROUTER=0x8a1E35F5c98C4E85B36B7B253222eE17773b2781   # SwapRouter
SPARKDEX_QUOTER=0x5B5513c55fd06e2658010c121c37b07fC8e8B705   # QuoterV2
SPARKDEX_V2_FACTORY=0x16b619B04c961E8f4F06C10B42FDAbb328980A89
SPARKDEX_V2_ROUTER=0x4a1E5A90e9943467FAd1acea1E7F0e5e88472a1e

# --- Ēnosys (suite DeFi Flare) ---
ENOSYS_ROUTER=
ENOSYS_FACTORY=
ENOSYS_FARMING=
ENOSYS_POOL_MANAGER=
ENOSYS_REWARD_CONTRACT=
ENOSYS_LENDING_POOL=

# --- Firelight (XRP liquid staking) ---
# stXRP IS the ERC-4626 vault. Verified on-chain 2026-07-10:
# name()="Firelight stXRP", asset()==FXRP_TOKEN, 6 decimals.
FIRELIGHT_STAKING=0x4C18Ff3C89632c3Dd62E796c0aFA5c07c4c1B2b3
FIRELIGHT_STXRP=0x4C18Ff3C89632c3Dd62E796c0aFA5c07c4c1B2b3

# --- Upshift (August Digital) vaults on Flare — partner XRP yield vaults ---
# Vault = proxy, NOT the ERC-20: receipt tokens via lpTokenAddress(). Both
# verified on-chain 2026-07-10 (asset()==FXRP, sendersWhitelist==0x0).
UPSHIFT_EARNXRP_VAULT=0x373D7d201C8134D4a2f7b5c63560da217e3dEA28
UPSHIFT_EARNXRP_TOKEN=0xE533E447fD7720b2F8654da2B1953Efa06b60bfA
UPSHIFT_MONARQ_VAULT=0x2439D4bb753A0f3777d4C9011AFacc475ba6B951
UPSHIFT_MONARQ_TOKEN=0x36f236af59CB279bab884e464Ef1Bc23c7B1a115
# Monarq runs OFF-chain strategies (CeDeFi profile) → its own switch on top of
# FLARE_DEFI_ENABLED. Founder decision 2026-07-11: offered from minute 0.
UPSHIFT_MONARQ_ENABLED=true

# --- Morpho Blue markets the position scanner enumerates (watch-only) ---
# Base (8453) cbXRP/USDC markets behind Coinbase's XRP-backed loans
# (verified via blue-api.morpho.org 2026-07-10).
MORPHO_BLUE_MARKET_IDS=0xd4a903dc6d949519060c7707f9604fdc9772c046e05c2e3a8fce0bd7196e4109,0xfdfecf85a4dd90a7637ae2aaf28b35061166f0e62bfc714c565eed9f7e959783

# --- Verified Flare token addresses (2026-05-23) ---
FXRP_TOKEN=0xAd552A648C74D49E10027AB8a618A3ad4901c5bE  # FAssets FXRP ERC-20 (verified 2026-07-10, matches .env.example)
SFLR_TOKEN=0x12e605bc104e93B45e1aD99F9e555f659051c2BB
USDCE_TOKEN=0xFbDa5F676cB37624f28265A144A48B0d6e87d3b6
USDT_FLARE_TOKEN=0x0B38e83B86d491735fEaa0a791F65c2B99535396
SCEPTRE_POOL=                            # sFLR liquid staking (Sceptre — pending)

# ============================================================================
# WALLET SIGNING (Turnkey)
# ============================================================================

TURNKEY_BASE_URL=https://api.turnkey.com
TURNKEY_API_PUBLIC_KEY=
TURNKEY_ORG_ID=

# ============================================================================
# FEE ATTRIBUTION — Revenue model
# ============================================================================

# EVM wallet that receives on-chain referral fees (1inch, Lido, etc.)
ASTRYUM_FEE_WALLET=

# 1inch swap fee (basis points, 15 = 0.15%)
ONEINCH_FEE_BPS=15
ONEINCH_API_KEY=

# Aave/Kinetic referral code (uint16)
ASTRYUM_REFERRAL_CODE=

# Li.Fi cross-chain swaps
LIFI_INTEGRATOR=astryum
LIFI_FEE_BPS=15                          # Li.Fi fee in basis points (default 15 = 0.15%)
LIFI_API_KEY=                            # optional — higher rate limit

# Jupiter (Solana) fee account — same as ASTRYUM_FEE_WALLET but Solana pubkey
JUPITER_FEE_ACCOUNT=
JUPITER_FEE_BPS=20

# ============================================================================
# CROSS-CHAIN SWAPS
# ============================================================================

# Squid Router (Axelar-based, 70+ chains) — enables SquidRouterProvider
# Register free at: https://axelar.network/squid
SQUID_INTEGRATOR_ID=
SQUID_FEE_BPS=15                         # Squid referral fee in basis points

# CoW Protocol — no API key required. Revenue via appData surplus sharing.
ASTRYUM_COW_APP_CODE=Astryum

# ============================================================================
# MOONPAY (Partner — fiat ↔ crypto + B2B DeFi execution)
# ============================================================================

MOONPAY_API_KEY=
MOONPAY_WEBHOOK_SECRET=

# MoonPay Trade — B2B DeFi execution engine (Aave, Morpho, Uniswap, 200+ chains)
# V1.5+ feature — only enable after signing B2B agreement at moonpay.com/business
MOONPAY_TRADE_ENABLED=                   # set to "true" to activate
MOONPAY_TRADE_FEE_BPS=20

# ============================================================================
# CROSSMINT (KYC / Identity — V1.2)
# Astryum receives only { verified, level, wallets } — never documents or PII.
# ============================================================================

CROSSMINT_API_KEY=
CROSSMINT_WEBHOOK_SECRET=
CROSSMINT_REDIRECT_BASE_URL=https://astryum.xyz/app/kyc

# ============================================================================
# PORTFOLIO READERS
# ============================================================================

# CoinStats Open API — single broad multichain portfolio source (D2). 120+ chains.
COINSTATS_API_KEY=
# ZERION_API_KEY — DISCONNECTED from production 2026-06-15 (D2). Left blank; not used.
ZERION_API_KEY=
DEBANK_ACCESS_KEY=

# ============================================================================
# CHAIN EXPLORER / ABI FETCHING (ChainExplorerProvider)
# ============================================================================

# Etherscan-compatible key — used by ProtocolIntegrationService for ABI auto-fetch
# Get free key at: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# ============================================================================
# DEFI BUNDLES (Enso Finance — atomic multi-step DeFi)
# ============================================================================

# Get key at: https://enso.finance/api
ENSO_API_KEY=

# ============================================================================
# SECURITY MONITORING (Hypernative)
# ============================================================================

# Get key at: https://hypernative.io
HYPERNATIVE_API_KEY=
HYPERNATIVE_WEBHOOK_SECRET=              # optional — for webhook HMAC verification

# ============================================================================
# AI
# ============================================================================

ANTHROPIC_API_KEY=

# ============================================================================
# AGENT SYSTEM (P-AGENT-1)
# ============================================================================

# AES-256-GCM master key for encrypting user Anthropic API keys stored in DB.
# Generate: openssl rand -base64 32
# Falls back to JWT_SECRET if not set — set explicitly in prod for key isolation.
AGENT_KEY_SECRET=                        # REQUIRED if agent system is active

# ============================================================================
# PUSH NOTIFICATIONS (Expo → FCM/APNs)
# ============================================================================

EXPO_ACCESS_TOKEN=

# ============================================================================
# WALLET INTEGRATIONS
# ============================================================================

XAMAN_API_KEY=
XAMAN_API_SECRET=

# ============================================================================
# YELLOW STATE CHANNELS (V2+ broker-to-broker settlement — niche use)
# ============================================================================

YELLOW_PERUN_KEY=                        # Perun node key (broker registration required)
YELLOW_BROKER_MODE=                      # set to "true" to enable (V2+ only)

# ============================================================================
# OBSERVABILITY (optional)
# ============================================================================

SENTRY_DSN=
DATADOG_API_KEY=
GRAFANA_URL=

# ============================================================================
# BETA GATE (founder 2026-08-01) - FAIL-CLOSED
# ============================================================================
# 'true' => open registration. Anything else (unset/typo) => CLOSED: only
# founder-approved waitlist emails can create an account (admin panel).
BETA_REGISTRATION_OPEN=

# ============================================================================
# LEGACY COUNCIL STACK (Flare mainnet - stack 2026-07-22, factory 2026-08-05)
# ============================================================================
# LEGACY_CHAIN defaults to MAINNET (flare) since 2026-08-06; test rigs must set
# coston2 explicitly. Missing addresses fail with a readable error - council
# routes never fall back to another cage. Addresses live in contracts/README.md.
LEGACY_ENABLED=                          # 'true' => council/legacy routes on
LEGACY_ACCESS_EMAILS=                    # comma-separated allowlist (the family)
LEGACY_CHAIN=flare
LEGACY_BRIDGE_ADDRESS=                   # XrplCouncilBridge (0x...)
LEGACY_VAULT_ADDRESS=                    # LegacyVault (0x...)
LEGACY_FACTORY_ADDRESS=                  # LegacyStackFactory (0x...)
LEGACY_FACTORY_DEPLOY_BLOCK=             # factory deploy block (log scan floor)
LEGACY_ORDER_ANCHOR=                     # XRPL r-address receiving the 1-drop order Payments
LEGACY_ORDER_FEE_ENABLED=                # 'true' => charge the order fee
LEGACY_ORDER_FEE_XRP=                    # e.g. 0.2
LEGACY_DAILY_FEE_RESERVE_FLR=            # FLR/day reserved for council FDC fees (runbook: 60)
LEGACY_CAGE_MAX_TOTAL_XRP=               # beta cap per cage
LEGACY_PROTOCOL_TREASURY=                # protocol yield-cut recipient (0x...)
LEGACY_ANCHOR_SEED=                      # optional hop B3; unset = silent no-op
                                         # family seed (s...) OR Xaman secret numbers (8x6 digits)
LEGACY_ANCHOR_RESERVE_XRP=
LEGACY_ANCHOR_FEED_MIN_XRP=
LEGACY_XRPL_RPC=                         # optional XRPL JSON-RPC override

# FDC infra (council relay + 0xFE executor share these)
FDC_VERIFIER_API_KEY=                    # unset => public zero key; rounds can fail LATE (fee already paid)
FDC_VERIFIER_URL=
FDC_DA_LAYER_URL=
